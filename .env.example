# Copie para .env e preencha. O .env nunca vai para o git.

# Senha do SA do SQL Server em container. Precisa ser a mesma nos dois lugares abaixo.
SENHA_SA=troque-esta-senha-Forte1

ConnectionStrings__Banco=Server=localhost,1434;Database=PlataformaBancaria;User Id=sa;Password=troque-esta-senha-Forte1;TrustServerCertificate=True

# Origens que a interface web usa. Sem curinga: o padrao e negar.
Web__Origens__0=http://localhost:5173

# Pasta dos documentos financeiros. Fora do webroot de proposito: nada aqui
# pode virar URL publica.
#
# PRECISA SER CAMINHO ABSOLUTO. A API e o worker sao processos separados, com pastas
# de trabalho diferentes: caminho relativo faz cada um apontar para uma pasta, e o
# arquivo que a API grava o worker nao acha. Troque pelo caminho da sua maquina.
Documentos__Raiz=C:/dados/plataforma-bancaria/documentos
